{
  "name": "blue-sine-management",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @blue-sine/api dev & pnpm --filter @blue-sine/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:migrate": "pnpm --filter @blue-sine/api db:migrate",
    "db:seed": "pnpm --filter @blue-sine/api db:seed"
  }
}